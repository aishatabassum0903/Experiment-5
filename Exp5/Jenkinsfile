pipeline {
    agent any

    stages {
        stage('Compile') {
            steps {
                bat 'javac Exp5\\hello.java'
            }
        }

        stage('Run') {
            steps {
                bat 'java -cp Exp5 hello'
            }
        }
    }

    post {
        success {
            echo 'BUILD SUCCESSFUL'
        }

        failure {
            echo 'BUILD FAILED'
        }
    }
}